# MinerU 服务配置

# 运行模式：private（私有模式，默认） | public（公开多租户模式）
# - private：默认直接使用本文件的 MINERU_API_KEY，客户端调用时无需提供 Authorization 请求头
# - public：客户端必须各自在请求头中传入 Authorization: Bearer <TOKEN>
MINERU_SERVICE_MODE=private

# MinerU 官方 API Token（私有模式下必填，从 https://mineru.net/apiManage/docs 获取）
MINERU_API_KEY=your_mineru_api_key_here
